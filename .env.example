# =========================================================================
# BookHub API - Environment Configuration Template
# Copy this file to .env in your application directory
# =========================================================================

# -------------------------------------------------------------------------
# 1. Database Configuration (MySQL / MariaDB)
# -------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/bookhub?createDatabaseIfNotExist=true&useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Ho_Chi_Minh
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_database_password
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# -------------------------------------------------------------------------
# 2. JWT Authentication & Security (MANDATORY TO SET IN PRODUCTION)
# Secret key for HMAC-SHA256 signature (must be at least 32 characters / 256 bits)
# -------------------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters_long_for_security

# Optional Token Expiration Policies (seconds)
JWT_ACCESS_TOKEN_EXPIRATION=1800
JWT_REFRESH_TOKEN_EXPIRATION=604800
JWT_RESET_TOKEN_EXPIRATION=600

# Optional Account Security Policies
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_DURATION=900
OTP_EXPIRATION=300
OTP_RESEND_INTERVAL=60
OTP_DAILY_LIMIT=5
OTP_MAX_ATTEMPTS=5

# -------------------------------------------------------------------------
# 3. VNPay Payment Gateway (Sandbox / Production)
# -------------------------------------------------------------------------
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://your-frontend-domain.com/checkout/result

# -------------------------------------------------------------------------
# 3.1. CORS & Domain Configuration
# -------------------------------------------------------------------------
BACKEND_URL=https://api.your-domain.com
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.com,https://api.your-domain.com,http://localhost:3000,http://localhost:5173

# -------------------------------------------------------------------------
# 4. Order & Checkout Policies
# -------------------------------------------------------------------------
ORDER_VNPAY_TIMEOUT_MINUTES=15
ORDER_BANK_TRANSFER_TIMEOUT_HOURS=48

# -------------------------------------------------------------------------
# 5. Customer & User Policies
# -------------------------------------------------------------------------
CUSTOMER_MAX_ADDRESSES=10

# -------------------------------------------------------------------------
# 6. Media & Storage Policies
# -------------------------------------------------------------------------
MEDIA_MAX_FILE_SIZE_MB=5
MEDIA_MAX_BATCH_FILES=10
MEDIA_CDN_BASE_URL=https://cdn.yourdomain.com

# -------------------------------------------------------------------------
# 7. Server Configuration
# -------------------------------------------------------------------------
SERVER_PORT=8080
